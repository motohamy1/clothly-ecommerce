# Clothly E-Commerce — Environment Variables
# Copy this file to .env and fill in your local values.
# WARNING: .env is gitignored; never commit real secrets.

# JWT signing secret — must be at least 32 random characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-32-char-random-string-please

# MongoDB connection string (dev default: localhost)
MONGODB_URI=mongodb://localhost:27017/clothly-ecommerce

# Admin credentials for the seed script (seed-admin.ts)
ADMIN_EMAIL=admin@clothly.test
ADMIN_PASSWORD=change-me-to-at-least-12-chars

# Backend URL used by the Next.js frontend to reach Express
BACKEND_URL=http://localhost:5000

# Express server port
PORT=5000
